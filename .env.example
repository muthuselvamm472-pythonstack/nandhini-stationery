# Nandhini Stationery - Environment Variables Template
# Copy this file to .env and fill in production credentials

SECRET_KEY=replace-with-cryptographically-random-64-char-key
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Set to True when SSL/HTTPS certificate is active
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

